# --- IBD Stock Screener credentials ---
IBD_USER=hhhhuuuuuhhhhhhhhh
IBD_PASSWORD=your-ibd-password

# --- Gmail SMTP (Nodemailer) ---
# Requires 2-Step Verification + an App Password:
# https://support.google.com/accounts/answer/185833
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=recipient@example.com
# Optional: defaults to GMAIL_USER if unset
# EMAIL_FROM="IBD Screener <your-gmail-address@gmail.com>"

# --- Scheduling / behavior ---
# Skip NYSE early-close days (default: false; we run because 13:30 PT = 16:30 ET, after the 13:00 ET early close)
SKIP_EARLY_CLOSE_DAYS=false

# --- Screener filters ---
# IBD New Highs cutoff. IBD's own UI default is 94 (yields ~100 stocks).
# Use 0 to include every stock with any rating, 80/85/90 for looser filters.
MIN_COMP_RATING=94
# Cap on returned rows (after sorting by Composite Rating). IBD's UI/export
# caps at 100. Use 0 for no cap.
MAX_RESULTS=100
# Aggregation threshold: only surface symbols that appear on at least this
# many preset lists. Default 2 (the "2 or more lists" signal).
MIN_LIST_COUNT=2

# --- Paths (optional overrides) ---
# DATA_DIR=./data
